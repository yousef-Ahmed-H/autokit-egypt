# ============================================================
# AutoKit Egypt — قالب متغيرات البيئة
# انسخ هذا الملف إلى .env.local للتطوير، واضبط القيم الحقيقية في الإنتاج.
# لا تضع أي قيمة حقيقية/سرية في هذا الملف وهو مُتتبَّع في Git.
# ============================================================

# ---------- الموقع ----------
# رابط الموقع العام (بدون / في النهاية) — يُستخدم في metadataBase وsitemap
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------- بيانات المتجر الظاهرة ----------
NEXT_PUBLIC_STORE_NAME=AutoKit Egypt
NEXT_PUBLIC_STORE_PHONE=+20 100 000 0000
NEXT_PUBLIC_STORE_EMAIL=info@example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# ---------- لوحة التحكم (آمنة — لا تُعرَض للمتصفح) ----------
# مطلوب في الإنتاج: 16 حرفًا على الأقل. بدونها يفشل تسجيل الدخول في الإنتاج.
ADMIN_SESSION_SECRET=
# إظهار حسابات الديمو في صفحة الدخول (فعّالة في التطوير فقط). اجعلها false في الإنتاج.
ADMIN_SHOW_DEMO=false
# زرع حسابات الديمو في المخزن عند أول تشغيل (اجعلها false في الإنتاج).
ADMIN_DEMO_SEED=true
# أول مالك في الإنتاج (يُستخدم مرة واحدة عند فراغ المخزن بدل بيانات الديمو)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# وضع الديمو (true/false). اتركه فارغًا: ديمو في التطوير، إنتاج في النشر.
NEXT_PUBLIC_DEMO_MODE=
# بديل آمن لأول مشرف في الإنتاج (يُستخدم فقط عند فراغ المخزن وعدم وجود ديمو).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# ---------- وضع العرض ----------
# true/false لإظهار بيانات ووسوم الديمو. الافتراضي: ديمو في التطوير فقط.
# في الإنتاج اتركها فارغة أو اضبطها false.
NEXT_PUBLIC_DEMO_MODE=

# ---------- قاعدة البيانات (Supabase) ----------
# اتركها فارغة الآن (يعمل الموقع بمخزن ملفات محلي للتطوير).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- شركات الشحن (تُقرأ فقط عند تفعيل الربط + الموافقة) ----------
# لا يتم إرسال أي شحنة فعلية بدون ضبط المفاتيح وموافقة صريحة.
BOSTA_API_KEY=
MYLERZ_API_KEY=
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=